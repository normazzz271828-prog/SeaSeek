# Dedicated website block; keep other sites and panel configuration intact.
map $http_upgrade $seaseek_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80;
    server_name seaseek.com.cn www.seaseek.com.cn;
    client_max_body_size 16m;

    location /.well-known/acme-challenge/ {
        root /var/lib/seaseek-web/acme;
    }
    location / {
        proxy_pass http://127.0.0.1:8505;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $seaseek_connection_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 120s;
    }
}
