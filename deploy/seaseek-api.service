[Unit]
Description=SeaSeek shared API
After=network.target

[Service]
Type=simple
User=seaseek
Group=seaseek
WorkingDirectory=/opt/seaseek
EnvironmentFile=/etc/seaseek/api.env
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=/opt/seaseek/.venv/bin/python -m uvicorn backend:app --host 127.0.0.1 --port 8766 --workers 1
Restart=on-failure
RestartSec=5
CPUQuota=100%
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/seaseek /opt/seaseek/.tmp

[Install]
WantedBy=multi-user.target
