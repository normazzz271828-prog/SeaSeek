# A dedicated server block; do not overwrite the TimeGlow configuration.
server {
    listen 443 ssl;
    server_name YOUR_API_HOST;
    ssl_certificate /etc/letsencrypt/live/YOUR_API_HOST/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_API_HOST/privkey.pem;
    client_max_body_size 24m;

    location / {
        proxy_pass http://127.0.0.1:8766;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
