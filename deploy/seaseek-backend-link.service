[Unit]
Description=SeaSeek restricted connection to the unified backend
After=network-online.target
Wants=network-online.target

[Service]
User=seaseek-web
Group=seaseek-web
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/seaseek-web/known_hosts -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -i /etc/seaseek-web/backend_ed25519 -L 127.0.0.1:8767:127.0.0.1:8766 root@47.104.156.204
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
